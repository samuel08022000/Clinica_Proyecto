APP_NAME="Clínica privada"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

QUARKUS_API_URL=http://localhost:8080/api/v1
QUARKUS_API_TIMEOUT=8
QUARKUS_API_CONNECT_TIMEOUT=3
QUARKUS_REGISTRATION_TIMEOUT=30

# Define estos paths solo cuando los controladores Quarkus correspondientes existan.
QUARKUS_SPECIALTIES_ENDPOINT=
QUARKUS_LOGIN_ENDPOINT=auth/login
QUARKUS_ME_ENDPOINT=auth/me
QUARKUS_AUTHORIZE_ENDPOINT=auth/authorize
QUARKUS_LOGOUT_ENDPOINT=auth/logout
QUARKUS_REGISTER_ENDPOINT=auth/register
QUARKUS_REQUEST_OTP_ENDPOINT=auth/otp/request
QUARKUS_VERIFY_OTP_ENDPOINT=auth/otp/verify
QUARKUS_RESEND_OTP_ENDPOINT=auth/otp/resend
QUARKUS_OTP_STATUS_ENDPOINT=auth/otp/status
QUARKUS_GOOGLE_AUTHORIZATION_ENDPOINT=auth/google/authorization-url
QUARKUS_GOOGLE_EXCHANGE_ENDPOINT=auth/google/exchange
QUARKUS_GOOGLE_REGISTER_ENDPOINT=auth/google/register
QUARKUS_GOOGLE_LINK_ENDPOINT=auth/google/link
QUARKUS_PASSWORD_FORGOT_ENDPOINT=auth/password/forgot
QUARKUS_PASSWORD_RESET_ENDPOINT=auth/password/reset

# Identidad institucional: mantener vacíos los datos aún no confirmados.
CLINIC_NAME="Clínica privada"
CLINIC_SHORT_NAME="Clínica"
CLINIC_DESCRIPTION="Atención médica y gestión de citas desde un portal claro y seguro."
CLINIC_PHONE=
CLINIC_EMAIL=
CLINIC_ADDRESS=
CLINIC_CITY=
CLINIC_HOURS_WEEKDAYS=
CLINIC_HOURS_SATURDAY=
CLINIC_HOURS_SUNDAY=

CLINIC_GOOGLE_OAUTH_ENABLED=false
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
CLINIC_EMAIL_VERIFICATION_ENABLED=false

# Las credenciales Google y AUTH_FRONTEND_BASE_URL pertenecen al backend.
