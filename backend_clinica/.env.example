QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://127.0.0.1:5433/db_clinica
QUARKUS_DATASOURCE_USERNAME=elige_tu_usuario_local
QUARKUS_DATASOURCE_PASSWORD=

# Solo desarrollo local: habilita el proveedor en memoria y protege la consulta del codigo.
OTP_DELIVERY_PROVIDER=disabled
OTP_DEMO_ACCESS_KEY=

# Gmail SMTP: completar solo en backend_clinica/.env y cambiar el proveedor a smtp.
QUARKUS_MAILER_HOST=smtp.gmail.com
QUARKUS_MAILER_PORT=587
QUARKUS_MAILER_TIMEOUT=20S
QUARKUS_MAILER_START_TLS=REQUIRED
QUARKUS_MAILER_TLS=false
QUARKUS_MAILER_MOCK=true
QUARKUS_MAILER_LOGIN=REQUIRED
QUARKUS_MAILER_AUTH_METHODS=DIGEST-MD5 CRAM-SHA256 CRAM-SHA1 CRAM-MD5 PLAIN LOGIN
QUARKUS_MAILER_USERNAME=your-email@gmail.com
QUARKUS_MAILER_FROM=your-email@gmail.com
QUARKUS_MAILER_PASSWORD=YOUR_GMAIL_APP_PASSWORD

# Google Sign-In (cliente OAuth 2.0 tipo Aplicacion web).
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# URL publica de Laravel usada para construir enlaces de recuperacion.
AUTH_FRONTEND_BASE_URL=http://127.0.0.1:8000
