/*
 * MIGRACION EXCLUSIVA DE DESARROLLO.
 *
 * Esta plantilla no pertenece a classpath:db/migration y no contiene una
 * contrasena reutilizable. prepare-demo-credentials.ps1 genera una copia local
 * ignorada por Git en db/dev-migration/ con un hash BCrypt distinto por equipo.
 */
DO $migration$
DECLARE
    v_esperados integer;
    v_actualizados integer;
BEGIN
    IF '${environment}' <> 'development' THEN
        RAISE EXCEPTION 'La migracion de credenciales demo solo se permite en desarrollo.';
    END IF;

    IF current_database() <> 'db_clinica' THEN
        RAISE EXCEPTION 'Base de datos no autorizada para credenciales demo: %.', current_database();
    END IF;

    SELECT count(*)
      INTO v_esperados
      FROM (
          VALUES
            ('Samuel Paciente', 'samuel.paciente@unifranz.edu.bo', 'ROL001'),
            ('Angela Secretaria', 'angela.secretaria@clinica.bo', 'ROL002'),
            ('Dr. Dilan Doctor', 'dilan.doctor@clinica.bo', 'ROL003'),
            ('Yesid Administrador', 'yesid.admin@clinica.bo', 'ROL004')
      ) AS esperado(nombre, email, cod_rol)
      JOIN public.usuarios u
        ON lower(trim(u.email)) = esperado.email
       AND u.nombre_completo = esperado.nombre
       AND u.cod_rol = esperado.cod_rol
       AND u.estado = 'Activo'
       AND u.cod_usu ~ '^USU[0-9]{6}$'
     WHERE CASE esperado.cod_rol
         WHEN 'ROL001' THEN EXISTS (
             SELECT 1 FROM public.pacientes p
              WHERE p.cod_usu = u.cod_usu AND p.estado_cuenta = 'Activo')
         WHEN 'ROL002' THEN EXISTS (
             SELECT 1 FROM public.secretarias s
              WHERE s.cod_usu = u.cod_usu AND s.estado = 'Activo')
         WHEN 'ROL003' THEN EXISTS (
             SELECT 1 FROM public.medicos m
              WHERE m.cod_usu = u.cod_usu AND m.estado = 'Activo')
         WHEN 'ROL004' THEN true
         ELSE false
     END;

    IF v_esperados <> 4 THEN
        RAISE EXCEPTION
            'Se esperaban exactamente cuatro usuarios demo activos con sus roles y perfiles; encontrados: %.',
            v_esperados;
    END IF;

    UPDATE public.usuarios u
       SET password_hash = '__BCRYPT_HASH__'
      FROM (
          VALUES
            ('samuel.paciente@unifranz.edu.bo', 'ROL001'),
            ('angela.secretaria@clinica.bo', 'ROL002'),
            ('dilan.doctor@clinica.bo', 'ROL003'),
            ('yesid.admin@clinica.bo', 'ROL004')
      ) AS esperado(email, cod_rol)
     WHERE lower(trim(u.email)) = esperado.email
       AND u.cod_rol = esperado.cod_rol;

    GET DIAGNOSTICS v_actualizados = ROW_COUNT;
    IF v_actualizados <> 4 THEN
        RAISE EXCEPTION
            'La actualizacion demo debia afectar cuatro usuarios; afectados: %.',
            v_actualizados;
    END IF;
END;
$migration$;
